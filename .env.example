# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — this file is the safe, password-free template.

# Port the Go API listens on.
PORT=8080

# Full PostgreSQL connection string (takes precedence over the discrete
# DB_* variables below). For Supabase, use the connection pooler host from
# Project Settings -> Database -> Connection Pooling.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Alternative to DATABASE_URL: discrete connection settings, used only if
# DATABASE_URL is unset (matches docker-compose.yml's local Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USER=project_hub
DB_PASSWORD=project_hub
DB_NAME=project_hub
DB_SSLMODE=disable

# Secret used to sign JWTs. Always override this in any real deployment.
JWT_SECRET=dev-secret-change-me
# Go duration string, e.g. 24h, 15m.
JWT_TTL=24h

# Directory uploaded project files are stored under.
UPLOAD_DIR=./uploads

# Shared secret required in POST /auth/register to self-grant the ADMIN
# (curator) role. Always override this in any real deployment.
ADMIN_SECRET_KEY=kbtu_curator_secret_2026
